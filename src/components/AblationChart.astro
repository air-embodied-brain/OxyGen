---
import ResultDetails from "./ResultDetails.astro";
import { ablation, ablationN } from "../data/paper-figures";

const devices = [
  { id: "rtx4090", label: "RTX 4090", max: 75, ticks: [0, 25, 50, 75], cls: "c1-6" },
  { id: "thor", label: "Jetson AGX Thor", max: 35, ticks: [0, 10, 20, 30], cls: "c7-12" },
] as const;
const series = [
  { key: "baseline", label: "Isolated baseline", cls: "s-baseline" },
  { key: "parallel", label: "Parallel (MPS)", cls: "s-parallel" },
  { key: "no_batching", label: "+ KV sharing", cls: "s-nobatch" },
  { key: "ours", label: "+ batching = OxyGen", cls: "s-k1" },
] as const;

const W = 528;
const H = 250;
// Same plot margins as the throughput chart, so the two figures' axes line up.
const M = { l: 36, r: 84, t: 22, b: 40 };
const INSET = 14;
const sx = (i: number) => M.l + INSET + (i / (ablationN.length - 1)) * (W - M.l - M.r - 2 * INSET);
const N = ablationN.at(-1);
---

<figure data-ablation>
  <div class="fig-head">
    <span class="title">Batching keeps actions fast as language requests grow longer.</span>
    <div class="switch" role="tablist" aria-label="Device">
      {devices.map((d, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-ablation-device={d.id}>{d.label}</button>)}
    </div>
  </div>
  <div class="grid">
    {devices.map((d, i) => {
      const data = ablation[d.id];
      const sy = (v: number) => H - M.b - (v / d.max) * (H - M.t - M.b);
      const gain = data.ours.at(-1)! / data.baseline.at(-1)!;
      return (
        <div class:list={[d.cls, "chart", i !== 0 && "off"]} data-ablation-panel={d.id}>
          <div class="panel-head"><span>{d.label}</span><span class="gain">{gain.toFixed(1)}×<small>at {N}-token requests</small></span></div>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${d.label}: action frequency by request length for each execution mode`}>
            <g class="gridlines">{d.ticks.slice(1).map((t) => <line x1={M.l} x2={W - M.r} y1={sy(t)} y2={sy(t)} />)}</g>
            <g class="axis"><line x1={M.l} x2={W - M.r} y1={H - M.b} y2={H - M.b} /></g>
            <g class="ticklabels">
              {d.ticks.slice(1).map((t) => <text x={M.l - 7} y={sy(t) + 4} text-anchor="end">{t}</text>)}
              {ablationN.map((n, i) => <text x={sx(i)} y={H - M.b + 16} text-anchor="middle">{n}</text>)}
            </g>
            <text class="axis-title" x={W - M.r} y={H - 4} text-anchor="end">Tokens per language request →</text>
            <text class="axis-title" x={M.l} y={M.t - 8}>↑ Action frequency (Hz)</text>
            <line x1={M.l} x2={W - M.r} y1={sy(data.upperBound)} y2={sy(data.upperBound)} stroke="var(--ink)" stroke-dasharray="3 4" stroke-width="1" />
            {series.map((s) => (
              <g class:list={["series", s.cls]}>
                <path d={data[s.key].map((v, i) => `${i ? "L" : "M"}${sx(i).toFixed(1)},${sy(v).toFixed(1)}`).join("")} pathLength="1" />
                {data[s.key].map((v, i) => <circle cx={sx(i)} cy={sy(v)} r="2.8" />)}
                {(s.key === "ours" || s.key === "no_batching") && <text class="end" x={W - M.r + 8} y={sy(data[s.key].at(-1)!) + 4}>{s.key === "ours" ? "batched" : "KV only"}</text>}
                {data[s.key].map((v, i) => <circle class="hit" cx={sx(i)} cy={sy(v)} r="10" data-tip={`${s.label}\n${ablationN[i]}-token requests\n${v.toFixed(1)} Hz`} />)}
              </g>
            ))}
          </svg>
        </div>
      );
    })}
  </div>
  <div class="key">
    {series.map((s) => <span class={s.cls}><i class="line" style="background: currentColor"></i>{s.label}</span>)}
    <span><i class="dash"></i>one frame of decoding only</span>
  </div>
  <ResultDetails id="ablation-details"><p>π<sub>0.5</sub> on LIBERO, <i>S</i> = 10 and <i>k</i> = 5. Gains compare OxyGen with isolated execution at 30 tokens per request. KV sharing and cross-frame batching are added in turn to isolate their contributions.</p><p>The dashed oracle decodes only <i>k</i> tokens and discards the rest. It is a reference bound, not a method that completes the same language workload.</p></ResultDetails>
</figure>
