---
interface Props {
  number: string;
  label: string;
}

const { number, label } = Astro.props;
const hasDek = Astro.slots.has("default");
---

<div class:list={["section-head grid", !hasDek && "solo"]}>
  <p class="label"><b>§ {number}</b> · {label}</p>
  <h2><slot name="title" /></h2>
  {hasDek && <p class="dek"><slot /></p>}
</div>
