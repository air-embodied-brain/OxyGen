---
import ResultDetails from "./ResultDetails.astro";
import { tradeoff } from "../data/paper-figures";
import { scaling, starvla, xiaomi } from "../data/paper-tables";

// Speedup over isolated execution with 30-token requests. π0.5 values are
// action-frequency ratios from the LIBERO results (S=10); the others are
// frame-latency ratios from the appendix tables.
const pi = tradeoff.libero.rtx4090;
const n30 = <T extends { N: number }>(rows: T[]) => rows.find((r) => r.N === 30)!;
const qwen = (backbone: string, tp: number) => scaling.find((r) => r.backbone === backbone && r.tp === tp && r.N === 30)!;

const groups = [
  {
    label: "Across architectures", finding: "Sharing and batching transfer beyond π0.5.",
    rows: [
      { name: "π0.5", note: "", k1: pi.k1.at(-1)![1] / pi.baseline.at(-1)![1], k5: pi.k5.at(-1)![1] / pi.baseline.at(-1)![1] },
      { name: "Xiaomi-Robotics-0", note: "", ...n30(xiaomi) },
      { name: "StarVLA", note: "Qwen3-VL-4B + PI_v3", ...n30(starvla[2]) },
    ],
  },
  {
    label: "More experts", finding: "Speedup holds as experts increase.",
    rows: [
      { name: "+ GR00T", note: "3 experts", ...n30(starvla[3]) },
      { name: "+ GR00T + OFT", note: "4 experts", ...n30(starvla[4]) },
    ],
  },
  {
    label: "Across backbone sizes", finding: "The gain persists as the backbone grows.",
    rows: [
      ...["0.8B", "2B", "4B", "9B"].map((b) => ({ name: `Qwen3.5-${b}`, note: "", ...qwen(b, 1) })),
    ],
  },
];
const MAX = Math.ceil(Math.max(...groups.flatMap((group) => group.rows.flatMap((row) => [row.k1, row.k5]))));
const pct = (v: number) => ((v / MAX) * 100).toFixed(2);
---

<div class="generality" data-bar-reveal>
  <figure>
    <div class="fig-head"><span class="title">Speedups transfer across VLA architectures, expert counts and backbone sizes.</span></div>
    <table class="data">
      <thead>
        <tr><th scope="col" class="configuration">Configuration</th><th scope="col" class="bar-heading">k = 1 / k = 5 · 0–{MAX}×</th></tr>
      </thead>
      {groups.map((group) => (
        <tbody>
          <tr class="group"><th colspan="2"><span>{group.label}</span><small>{group.finding}</small></th></tr>
          {group.rows.map((row) => (
            <tr>
              <td class="name">{row.name}{row.note && <small>{row.note}</small>}</td>
              <td class="bar"><div class="spark" style={`--one: ${pct(1)}`}><div class="spark-pair"><i data-grow class="k1" style={`width: ${pct(row.k1)}%`}></i><i data-grow class="k5" style={`width: ${pct(row.k5)}%`}></i></div><span>{row.k1.toFixed(2)}× / {row.k5.toFixed(2)}×</span></div></td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
    <div class="key">
      <span><i style="background: var(--series-k1)"></i>k = 1</span>
      <span><i style="background: var(--series-k5)"></i>k = 5</span>
      <span><i style="width: 1px; height: 12px; background: var(--ink)"></i>isolated baseline · 1×</span>
    </div>
    <ResultDetails id="generality-details" label="Details (three experiments)">
      <p>Shared details for the throughput, batching and transfer experiments.</p>
      <p>All use π<sub>0.5</sub> on LIBERO, 30-token requests, and speedup over each configuration’s isolated baseline. <i>k</i> is the per-frame decoding budget; <i>S</i> = 10 for π<sub>0.5</sub>. The throughput chart compares RTX 4090 and Jetson AGX Thor; the batching chart uses <i>k</i> = 5. Ringed points match the same workload.</p>
      <p>Transfer runs use one RTX 4090 and an i9-13900K (Xiaomi <i>S</i> = 5; StarVLA/Qwen3.5 <i>S</i> = 4). Runtime scaling uses random parameters; policy quality is validated separately with the official checkpoint.</p>
    </ResultDetails>
  </figure>
</div>
