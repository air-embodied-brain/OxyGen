---
import { tradeoff } from "../data/paper-figures";
import { scaling, starvla, tensorParallel, xiaomi } from "../data/paper-tables";

// Speedup over isolated execution with 30-token requests. π0.5 values are
// action-frequency ratios from the LIBERO results (S=10); the others are
// frame-latency ratios from the appendix tables.
const pi = tradeoff.libero.rtx4090;
const n30 = <T extends { N: number }>(rows: T[]) => rows.find((r) => r.N === 30)!;
const qwen = (backbone: string, tp: number) => scaling.find((r) => r.backbone === backbone && r.tp === tp && r.N === 30)!;

const groups = [
  {
    label: "Models, one action expert",
    rows: [
      { name: "π0.5", note: "S = 10", k1: pi.k1.at(-1)![1] / pi.baseline.at(-1)![1], k5: pi.k5.at(-1)![1] / pi.baseline.at(-1)![1] },
      { name: "Xiaomi-Robotics-0", note: "S = 5", ...n30(xiaomi) },
      { name: "StarVLA", note: "Qwen3-VL-4B + PI_v3", ...n30(starvla[2]) },
    ],
  },
  {
    label: "More experts on one prefix (StarVLA)",
    rows: [
      { name: "+ GR00T", note: "3 experts", ...n30(starvla[3]) },
      { name: "+ GR00T + OFT", note: "4 experts", ...n30(starvla[4]) },
    ],
  },
  {
    label: "Backbone size (Qwen3.5 via StarVLA)",
    rows: [
      ...["0.8B", "2B", "4B", "9B"].map((b) => ({ name: `Qwen3.5-${b}`, note: "", ...qwen(b, 1) })),
    ],
  },
];
const MAX = Math.ceil(Math.max(...groups.flatMap((group) => group.rows.flatMap((row) => [row.k1, row.k5]))));
const scalingK5 = scaling.filter((row) => row.N === 30).map((row) => row.k5);
const tp1 = tensorParallel[0];
const tp2 = tensorParallel[1];
const pct = (v: number) => ((v / MAX) * 100).toFixed(2);
const shortN = starvla[2].find((r) => r.N === 5)!.k5;
const shortN3 = starvla[3].find((r) => r.N === 5)!.k5;
const shortN4 = starvla[4].find((r) => r.N === 5)!.k5;
const boundary = xiaomi.find((r) => r.N === 10)!.k10!;
---

<div class="grid">
  <figure class="c1-8">
    <div class="fig-head"><span class="title"><span class="label"><b>Table 1</b></span>Speedup over isolated execution, 30-token requests</span></div>
    <table class="data">
      <thead>
        <tr><th scope="col" style="text-align: left"><span class="sr-only">Configuration</span></th><th scope="col" class="k">k = 1</th><th scope="col" class="k">k = 5</th><th scope="col"><span class="sr-only">Bars</span></th></tr>
      </thead>
      {groups.slice(0, 2).map((group) => (
        <tbody>
          <tr class="group"><th colspan="4">{group.label}</th></tr>
          {group.rows.map((row) => (
            <tr>
              <td class="name">{row.name}{row.note && <small>{row.note}</small>}</td>
              <td>{row.k1.toFixed(2)}×</td>
              <td>{row.k5.toFixed(2)}×</td>
              <td class="bar"><div class="spark" style={`--one: ${pct(1)}`}><i class="k1" style={`width: ${pct(row.k1)}%`}></i><i style={`width: ${pct(row.k5)}%`}></i></div></td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
    <div class="key">
      <span><i style="background: var(--action-3)"></i>k = 1</span>
      <span><i style="background: var(--action)"></i>k = 5</span>
      <span><i style="width: 1px; height: 12px; background: var(--ink)"></i>1×</span>
    </div>
    <figcaption class="caption">π<sub>0.5</sub>: original paper measurements. Other rows: camera-ready remeasurements on RTX 4090 with an i9-13900K. StarVLA and Qwen3.5 use <i>S</i> = 4. Different host and software setups mean absolute latency is not compared across these groups.</figcaption>

  </figure>

  <aside class="c9-12">
    <div class="fig-head"><span class="title">What transfers</span></div>
    <div class="side-note">
      <strong>{shortN.toFixed(2)}× → {shortN4.toFixed(2)}×</strong>
      <p>With 5-token answers, nothing is batched across frames. The gain then comes from sharing the prefix, and grows as StarVLA goes from two to four experts (including language), with {shortN3.toFixed(2)}× at three experts.</p>
    </div>
    <p class="caption transfer-conclusion">Every tested Xiaomi and StarVLA configuration with <i>N</i> &gt; <i>k</i> is faster: unfinished requests create the batch.</p>
    <details class="experiment-note"><summary>When requests finish in one frame</summary><p>Xiaomi at N = k = 10 reaches {boundary.toFixed(2)}×. With no requests carried over, cross-frame batching offers no amortization.</p></details>
    <p class="caption">Each speedup uses its own configuration's isolated baseline. Xiaomi, StarVLA and Qwen3.5 are camera-ready performance measurements on one RTX 4090 with random parameters; they measure runtime scaling. Policy success is evaluated separately below with the official π<sub>0.5</sub> checkpoint.</p>
  </aside>
</div>

<div class="grid scaling-study">
  <div class="c1-4">
    <span class="label">Backbone scale / Qwen3.5</span>
    <h4>Similar gains,<br /><em>0.8B to 9B.</em></h4>
    <p class="caption">At <i>k</i> = 5, speedup stays between {Math.min(...scalingK5).toFixed(2)}× and {Math.max(...scalingK5).toFixed(2)}×. All four sizes use a matching PI_v3 action head.</p>
  </div>
  <figure class="c5-12">
    <div class="key scale-key"><span><i style="background: var(--action-3)"></i>k = 1</span><span><i style="background: var(--action)"></i>k = 5</span><span>common scale · 0–{MAX}×</span></div>
    <div class="scale-columns">
      {groups[2].rows.map((row) => <div><span class="label">{row.name.replace("Qwen3.5-", "")}</span><div class="scale-track"><i style={`height: ${pct(row.k1)}%`}></i><i style={`height: ${pct(row.k5)}%`}></i></div><strong>{row.k1.toFixed(2)}× <small>/ {row.k5.toFixed(2)}×</small></strong></div>)}
    </div>
    <figcaption class="caption">N = 30 · one RTX 4090 · S = 4. Values below each pair: k = 1 / k = 5.</figcaption>
  </figure>
</div>
<details class="experiment-note"><summary>Tensor parallelism on a separate server</summary>
    <p class="caption"><b>Tensor parallelism.</b> On a separate eight-GPU RTX 4090 server (PCIe, no NVLink), paired 9B runs retain {tp1.k5.toFixed(2)}× / {tp2.k5.toFixed(2)}× speedups at TP = 1 / 2 (<i>N</i> = 30, <i>k</i> = 5). OxyGen frame latency rises from {tp1.oxygenMs.toFixed(1)} to {tp2.oxygenMs.toFixed(1)} ms: the second GPU does not reduce latency in this setup.</p>
</details>
