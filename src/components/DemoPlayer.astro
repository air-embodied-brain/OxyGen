---
import { demos } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const first = demos[0];
---

<figure class="grid demo-comparison" data-demo data-base={base}>
  <div class="c1-9 demo-video">
    <video
      controls
      muted
      playsinline
      preload="metadata"
      poster={`${base}posters/${first.id}.webp`}
      data-demo-video
      aria-label={`${first.title}: OxyGen and the isolated baseline side by side`}
    >
      <source src={`${base}videos/${first.id}.mp4`} type="video/mp4" />
    </video>
  </div>
  <figcaption class="c10-12 demo-side">
    <div class="demo-outcome"><span class="label">Task completion</span><strong data-demo-gain>{(first.baselineS / first.oxygenS).toFixed(2)}×</strong><span>faster in this rollout</span><dl><div><dt>OxyGen</dt><dd data-demo-ours>{first.oxygenS.toFixed(1)} s</dd></div><div><dt>Isolated</dt><dd data-demo-base>{first.baselineS.toFixed(1)} s</dd></div></dl></div>
    <p class="caption"><b>FIG. 1</b> π<sub>0.5</sub> writes a memory at each replan. The baseline waits for the complete answer; OxyGen finishes it across subsequent frames.</p>
    <p class="caption"><span class="c-action">Teal: arm moving.</span> Amber: waiting for language.</p>
    <p class="caption">One RTX 4090; measured model time, simulation at 20 Hz, played at 1×. OxyGen decodes <i>k</i> = 1 token per request per frame.</p>
  </figcaption>
  <div class="demo-choices">    <div class="demo-list" role="tablist" aria-label="Demo tasks">
      {demos.map((demo, index) => (
        <button
          role="tab"
          type="button"
          aria-selected={index === 0 ? "true" : "false"}
          data-id={demo.id}
          data-ours={demo.oxygenS}
          data-baseline={demo.baselineS}
          data-label={demo.title}
          title={demo.task}
        >
          <span>{demo.title}</span>
          <small>OxyGen {demo.oxygenS.toFixed(1)} s · isolated {demo.baselineS.toFixed(1)} s</small>
        </button>
      ))}
    </div>
</div>
</figure>
