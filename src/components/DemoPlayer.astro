---
import { demos } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const first = demos[0];
---

<figure class="grid" data-demo data-base={base}>
  <div class="c1-9 demo-video">
    <video
      controls
      muted
      playsinline
      preload="metadata"
      poster={`${base}posters/${first.id}.webp`}
      data-demo-video
      aria-label={`${first.title}: OxyGen and the isolated baseline side by side`}
    >
      <source src={`${base}videos/${first.id}.mp4`} type="video/mp4" />
    </video>
  </div>
  <figcaption class="c10-12 demo-side crafted-demo-side">
    <p class="caption"><b>FIG. 1</b> π<sub>0.5</sub> writes a memory of task progress at every replan. The baseline waits for the full answer; OxyGen carries decoding across frames.</p>
    <p class="caption">Teal marks motion; amber marks time waiting for language.</p>
    <div class="demo-list" role="tablist" aria-label="Demo tasks">
      {demos.map((demo, index) => (
        <button
          role="tab"
          type="button"
          aria-selected={index === 0 ? "true" : "false"}
          data-id={demo.id}
          data-label={demo.title}
          title={demo.task}
        >
          <span>{demo.title}</span>
          <small>{demo.oxygenS.toFixed(1)} s vs {demo.baselineS.toFixed(1)} s · <b>{(demo.baselineS / demo.oxygenS).toFixed(2)}×</b></small>
        </button>
      ))}
    </div>
    <p class="caption">One RTX 4090; measured model time, simulation at 20 Hz, played at 1×. OxyGen decodes <i>k</i> = 1 token per request per frame.</p>
  </figcaption>
</figure>
