---
import { tradeoff } from "../data/paper-figures";
import { links } from "../data/site";

const authors = [
  { name: "Xiangyu Li", affiliation: "1", homepage: "https://xxxxyu.github.io" },
  { name: "Huaizhi Tang", affiliation: "2", note: "*" },
  { name: "Xin Ding", affiliation: "3", note: "*", homepage: "https://xinding-bot.github.io" },
  { name: "Weijun Wang", affiliation: "1" },
  { name: "Ting Cao", affiliation: "1", note: "†", homepage: "https://tingcao952.github.io" },
  { name: "Yunxin Liu", affiliation: "1", homepage: "https://yunxinliu.github.io" },
];

// π0.5 · LIBERO · RTX 4090 at N=30: OxyGen with k=1 against sequential isolated execution.
const libero = tradeoff.libero.rtx4090;
const ours = libero.k1.at(-1)!;
const base = libero.baseline.at(-1)!;
// The band plays both rates at one tenth of their measured values.
const SLOWDOWN = 10;
const tickGap = 12;
const rows = [
  { cls: "ours", name: "OxyGen", note: "shared KV, batched decoding", hz: ours[1], tps: ours[2] },
  { cls: "base", name: "Isolated baseline", note: "openpi, sequential", hz: base[1], tps: base[2] },
];
---

<header class="masthead page" id="top">
  <div class="masthead-top">
    <span class="label"><b>NeurIPS 2026</b> · Main Track</span>
    <span class="label">arXiv 2603.14371</span>
  </div>

  <div class="grid">
    <h1>OxyGen</h1>
    <p class="paper-title">Unified KV Cache Management for VLA Inference under Multi-Task Parallelism</p>
    <p class="dek">
      Robots increasingly need to act and talk at once. OxyGen lets a vision-language-action model share one KV cache across its action and language experts and across control frames, so neither task waits for the other.
    </p>
  </div>

  <div class="byline grid">
    <div class="names">
      {authors.map((author) => (
        <span>
          {author.homepage ? (
            <a href={author.homepage} target="_blank" rel="noreferrer">{author.name}</a>
          ) : author.name}
          <sup>{author.affiliation}{author.note}</sup>
        </span>
      ))}
    </div>
    <div class="affil">
      <p><sup>1</sup> Institute for AI Industry Research (AIR), Tsinghua University</p>
      <p><sup>2</sup> Department of Electronic Engineering, Tsinghua University</p>
      <p><sup>3</sup> University of Science and Technology of China</p>
    </div>
    <p class="notes">
      <sup>*</sup> Work done during internships at AIR, Tsinghua University. <sup>†</sup> Corresponding author: <a href="mailto:tingcao@mail.tsinghua.edu.cn">tingcao@mail.tsinghua.edu.cn</a>
    </p>
  </div>

  <nav class="links" aria-label="Paper links">
    <a href={links.paper} target="_blank" rel="noreferrer">Paper ↗</a>
    <a href={links.code} target="_blank" rel="noreferrer">Code ↗</a>
    <a href="#demo">Demo ↓</a>
    <a href={links.blog} target="_blank" rel="noreferrer">Blog post ↗</a>
  </nav>

  <figure class="rates grid" data-rates data-slowdown={SLOWDOWN} aria-label="Measured action frequency and language throughput">
    {rows.map((row) => (
      <div class:list={["rate-row", row.cls]} data-tps={row.tps}>
        <div class="rate-name">{row.name}<small>{row.note}</small></div>
        <div class="rate-lanes">
          <div class="ticks" style={`--gap: ${tickGap}px; --dur: ${((4 * SLOWDOWN) / row.hz).toFixed(3)}s`} aria-hidden="true"></div>
          <div class="words" aria-hidden="true"><span data-words></span></div>
        </div>
        <div class="rate-figs">
          <div><span>{row.hz.toFixed(0)}</span><small>Hz</small></div>
          <div><span>{row.tps.toFixed(0)}</span><small>tok/s</small></div>
        </div>
      </div>
    ))}
    <figcaption class="rates-caption note">
      Each tick is one action; the text is the model's own memory output. Both rows run at one tenth of the rates measured for π<sub>0.5</sub> on an RTX 4090 with 30-token language requests.
    </figcaption>
  </figure>
</header>
