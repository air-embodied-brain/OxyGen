---
import { links } from "../data/site";

const authors = [
  { name: "Xiangyu Li", affiliation: "1", homepage: "https://xxxxyu.github.io" },
  { name: "Huaizhi Tang", affiliation: "2", note: "*" },
  { name: "Xin Ding", affiliation: "3", note: "*", homepage: "https://xinding-bot.github.io" },
  { name: "Weijun Wang", affiliation: "1", homepage: "https://weijunalexwang.github.io" },
  { name: "Ting Cao", affiliation: "1", note: "†", homepage: "https://tingcao952.github.io" },
  { name: "Yunxin Liu", affiliation: "1", homepage: "https://yunxinliu.github.io" },
];

// Schematic schedule, not measured stage durations. Both rows share one time
// scale and repeat a whole tile, so the scrolling loop has no seam.
const schedule = [
  { name: "Isolated", note: "finish language, then act again", period: 240, action: 44, language: 182 },
  { name: "OxyGen", note: "advance language between action updates", period: 80, action: 44, language: 24 },
];
---

<header class="masthead page" id="top">
  <div class="masthead-top">
    <span class="label"><b>NeurIPS 2026</b> · Main Track</span>
    <span class="label">arXiv 2603.14371</span>
  </div>

  <div class="masthead-body grid">
    <div class="c1-7">
      <h1>OxyGen</h1>
      <p class="paper-title">Unified KV Cache Management for VLA Inference under Multi-Task Parallelism</p>
      <div class="byline">
        <div class="names">
          {authors.map((author) => (
            <span>
              {author.homepage ? (
                <a href={author.homepage} target="_blank" rel="noreferrer">{author.name}</a>
              ) : author.name}

            </span>
          ))}
        </div>
        <p class="project-affiliation">Institute for AI Industry Research (AIR), Tsinghua University</p>
      </div>
      <nav class="links" aria-label="Paper links">
        <a href={links.paper} target="_blank" rel="noreferrer">Paper ↗</a>
        <a href={links.code} target="_blank" rel="noreferrer">Code ↗</a>
        <a href="#demo">Demo ↓</a>
        <a href="#contact">Contact ↓</a>
        <a href={links.blog} target="_blank" rel="noreferrer">Blog post ↗</a>
      </nav>
    </div>

    <div class="c9-12">
      <p class="dek">
        Actions and language share what they see, but need not finish together. OxyGen unifies their KV state across tasks and control cycles, reusing observation computation while language generation continues across action updates.
      </p>

      <figure class="schedule-demo" aria-label="Illustrative inference schedule: isolated execution finishes each language request before the next action update; OxyGen batches language across updates.">
        <div class="second-head"><span class="label"><b>Two tasks, one schedule</b></span><span class="schedule-time">time →</span></div>
        {schedule.map((run) => (
          <div class="schedule-run">
            <div class="run-name">{run.name}</div>
            <div class="schedule-window" aria-hidden="true">
              <svg viewBox="0 0 320 28" preserveAspectRatio="none">
                <g class="schedule-tape">
                  {Array.from({length: 9}, (_,i) => <g transform={`translate(${i * run.period} 0)`}>
                    <rect x="0" y="3" width={run.action} height="14" fill="var(--action)" />
                    <rect x={run.action + 4} y="3" width={run.language} height="14" fill="var(--language)" />
                    {run.name === "OxyGen" && <><line x1={run.action + 4} x2={run.action + 4 + run.language} y1="8" y2="8" stroke="var(--paper)" stroke-width="1" /><line x1={run.action + 4} x2={run.action + 4 + run.language} y1="12" y2="12" stroke="var(--paper)" stroke-width="1" /></>}
                  </g>)}
                </g>
              </svg>
            </div>
            <p>{run.note}</p>
          </div>
        ))}
        <div class="key"><span><i style="background:var(--action)"></i>action</span><span><i style="background:var(--language)"></i>language</span></div>
        <figcaption class="caption">Illustrative timing. Short batched decoding steps let language progress across control cycles.</figcaption>
      </figure>
    </div>
  </div>
</header>
