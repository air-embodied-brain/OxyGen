---
import { tradeoff } from "../data/paper-figures";
import { links } from "../data/site";

const authors = [
  { name: "Xiangyu Li", affiliation: "1", homepage: "https://xxxxyu.github.io" },
  { name: "Huaizhi Tang", affiliation: "2", note: "*" },
  { name: "Xin Ding", affiliation: "3", note: "*", homepage: "https://xinding-bot.github.io" },
  { name: "Weijun Wang", affiliation: "1" },
  { name: "Ting Cao", affiliation: "1", note: "†", homepage: "https://tingcao952.github.io" },
  { name: "Yunxin Liu", affiliation: "1", homepage: "https://yunxinliu.github.io" },
];

// π0.5 · LIBERO · RTX 4090 with 30-token requests: OxyGen (k = 1) and sequential
// isolated execution. Each lane is a tape of marks at the measured rate that
// scrolls one window's width every SLOWDOWN × WINDOW seconds.
const libero = tradeoff.libero.rtx4090;
const ours = libero.k1.at(-1)!;
const base = libero.baseline.at(-1)!;
const SLOWDOWN = 10;
// Each lane spans half a second, so even 213 tok/s stays legible as marks.
const WINDOW = 0.5;
const runs = [
  { cls: "ours", name: "OxyGen", note: "shared KV, batched decoding", hz: ours[1], tps: ours[2] },
  { cls: "base", name: "Isolated baseline", note: "openpi, sequential", hz: base[1], tps: base[2] },
];
---

<header class="masthead page" id="top">
  <div class="masthead-top">
    <span class="label"><b>NeurIPS 2026</b> · Main Track</span>
    <span class="label">arXiv 2603.14371</span>
  </div>

  <div class="masthead-body grid">
    <div class="c1-7">
      <h1>OxyGen</h1>
      <p class="paper-title">Unified KV Cache Management for VLA Inference under Multi-Task Parallelism</p>
      <div class="byline">
        <div class="names">
          {authors.map((author) => (
            <span>
              {author.homepage ? (
                <a href={author.homepage} target="_blank" rel="noreferrer">{author.name}</a>
              ) : author.name}
              <sup>{author.affiliation}{author.note}</sup>
            </span>
          ))}
        </div>
        <p><sup>1</sup> Institute for AI Industry Research (AIR), Tsinghua University · <sup>2</sup> Department of Electronic Engineering, Tsinghua University · <sup>3</sup> University of Science and Technology of China</p>
        <p class="notes"><sup>*</sup> Work done during internships at AIR, Tsinghua University. <sup>†</sup> Corresponding author: <a href="mailto:tingcao@mail.tsinghua.edu.cn">tingcao@mail.tsinghua.edu.cn</a></p>
      </div>
      <nav class="links" aria-label="Paper links">
        <a href={links.paper} target="_blank" rel="noreferrer">Paper ↗</a>
        <a href={links.code} target="_blank" rel="noreferrer">Code ↗</a>
        <a href="#demo">Demo ↓</a>
        <a href={links.blog} target="_blank" rel="noreferrer">Blog post ↗</a>
      </nav>
    </div>

    <div class="c9-12">
      <p class="dek">
        Robots increasingly need to act and talk at once. OxyGen lets a vision-language-action model share one KV cache across its action and language experts and across control frames, so neither task waits for the other.
      </p>

      <figure class="second" style={`--period: ${SLOWDOWN * WINDOW}s`} aria-label="Actions and language tokens produced per second by OxyGen and the isolated baseline">
        <div class="second-head">
          <span class="label"><b>Inference</b>, live</span>
          <span class="clock">0.5 s shown · 1/{SLOWDOWN} speed</span>
        </div>
        {runs.map((run) => (
          <div class:list={["run", run.cls]} data-hz={run.hz} data-tps={run.tps}>
            <div class="run-name">{run.name}<small>{run.note}</small></div>
            <div class="lane-row">
              <span>Actions</span>
              <div class="marks act" style={`--n: ${(run.hz * WINDOW).toFixed(2)}`}><i class="tape"></i></div>
              <output><span data-count-up>{run.hz.toFixed(0)}</span><small>Hz</small></output>
            </div>
            <div class="lane-row">
              <span>Tokens</span>
              <div class="marks tokens" style={`--n: ${(run.tps * WINDOW).toFixed(2)}`}><i class="tape"></i></div>
              <output><span data-count-up>{run.tps.toFixed(0)}</span><small>tok/s</small></output>
            </div>
          </div>
        ))}
        <figcaption class="caption">
          Each mark is one action or one language token. Both tapes move at the same speed, so the spacing shows the measured rates: π<sub>0.5</sub> on an RTX 4090 with 30-token requests, slowed ten times.
        </figcaption>
      </figure>
    </div>
  </div>
</header>
