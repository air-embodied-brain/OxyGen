---
interface Props { id: string; label?: string; }
const { id, label = "Measurement details" } = Astro.props;
---
<div class="result-details">
  <button type="button" class="method-settings-trigger" popovertarget={id}>{label}</button>
  <div id={id} class="method-popover" popover aria-label="Measurement details">
    <strong>Measurement details</strong>
    <slot />
  </div>
</div>
