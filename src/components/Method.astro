---
import { ablation, ablationN } from "../data/paper-figures";
import { stageProfile } from "../data/paper-tables";
import Design from "./Design.astro";

// One control frame of π0.5-LIBERO on RTX 4090 at N=30, k=5. Totals are
// measured mean frame latencies (10 actions / action frequency) from the
// LIBERO ablation: baseline, shared KV only, OxyGen. Prefix and denoise widths
// follow the synchronized stage profile (Appendix tab:small-n-profile); the
// remaining width includes decoding and other frame work. The stage profile
// and original frame totals are separate measurements, so widths are illustrative.
const frameMs = (hz: number) => (10 / hz) * 1000;
const lab = ablation.rtx4090;
const PREFIX = stageProfile.prefixMs;
const DENOISE = stageProfile.denoiseMs;
const N = ablationN.at(-1)!;
const K = 5;
const modes = [
  {
    label: "Isolated",
    note: "openpi baseline",
    total: frameMs(lab.baseline.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "prefill repeat", ms: PREFIX, text: "prefill" },
      { kind: "decode", text: `1 request · ${N} tokens` },
    ],
  },
  {
    label: "+ KV sharing",
    note: "one prefill for both experts",
    total: frameMs(lab.no_batching.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "decode", text: `1 request · ${N} tokens` },
    ],
  },
  {
    label: "+ cross-frame batching",
    note: "OxyGen",
    total: frameMs(lab.ours.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "decode", text: `${N / K} requests × ${K} tokens` },
    ],
  },
];
const SCALE = 550;
const axis = [0, 100, 200, 300, 400, 500];
function layout(mode: (typeof modes)[number]) {
  const fixed = mode.blocks.reduce((sum, block) => sum + (block.ms ?? 0), 0);
  let cursor = 0;
  return mode.blocks.map((block) => {
    const ms = block.ms ?? mode.total - fixed;
    const item = { ...block, left: (cursor / SCALE) * 100, width: (ms / SCALE) * 100 };
    cursor += ms;
    return item;
  });
}
---

<Design />


<figure class="unit method-benefits" data-stage-animation>
    <div class="fig-head"><span class="title">KV sharing helps; batching delivers the larger latency reduction</span></div>
    <div class="lanes">
      {modes.map((mode) => (
        <div class="lane">
          <div class="lane-name">{mode.label}</div>
          <div class="lane-track">
            {layout(mode).map((block) => (
              <div class:list={["block", block.kind, mode.note === "OxyGen" && block.kind === "decode" && "batch-decode"]} style={`left: ${block.left}%; width: ${block.width}%`}>
                {mode.note === "OxyGen" && block.kind === "decode" && <span class="batch-layers" aria-hidden="true">{[0, 1, 2].map(layer => <i style={`--layer:${layer}`} />)}</span>}
                <span class="stage-block-label">{block.width > 10 ? block.text : ""}</span>
              </div>
            ))}
          </div>
          <div class="lane-total"><span data-stage-count={mode.total.toFixed(0)}>{mode.total.toFixed(0)}</span> ms</div>
        </div>
      ))}
      <div class="lane-axis" aria-hidden="true">
        <span></span>
        <div>{axis.map((ms) => <span style={`left: ${(ms / SCALE) * 100}%`}>{ms}</span>)}</div>
        <span>ms</span>
      </div>
    </div>
    <div class="key">
      <span><i style="background: var(--baseline)"></i>observation prefill</span>
      <span><i style="background: var(--action)"></i>action denoising</span>
      <span><i style="background: var(--language)"></i>language decoding</span>
    </div>
    <div class="method-caption-row">
      <figcaption class="caption">Sharing KV removes redundant prefill; batching amortizes decoding across unfinished requests.</figcaption>
      <button type="button" class="method-settings-trigger" popovertarget="method-settings">Measurement details</button>
      <div id="method-settings" class="method-popover" popover>
        <strong>RTX 4090 · π₀.₅ / LIBERO</strong>
        <p>H = 10 actions, S = 10 denoising steps, N = 30 tokens per language request, k = 5 decoding steps per frame. At steady state, six unfinished requests share a batch.</p>
        <p>Totals are derived from measured action frequency in the paper’s ablation (10 / Hz). Prefill ≈ {PREFIX.toFixed(1)} ms and denoising ≈ {DENOISE.toFixed(1)} ms come from a separate synchronized camera-ready profile. Stage widths are illustrative; the remainder includes decoding and other frame work.</p>
      </div>
    </div>
</figure>
