---
import { ablation, ablationN } from "../data/paper-figures";
import { stageProfile } from "../data/paper-tables";
import Design from "./Design.astro";

// One control frame of π0.5-LIBERO on RTX 4090 at N=30, k=5. Totals are
// measured mean frame latencies (10 actions / action frequency) from the
// LIBERO ablation: baseline, shared KV only, OxyGen. Prefix and denoise widths
// follow the synchronized stage profile (Appendix tab:small-n-profile); the
// remaining width includes decoding and other frame work. The stage profile
// and original frame totals are separate measurements, so widths are illustrative.
const frameMs = (hz: number) => (10 / hz) * 1000;
const lab = ablation.rtx4090;
const PREFIX = stageProfile.prefixMs;
const DENOISE = stageProfile.denoiseMs;
const N = ablationN.at(-1)!;
const K = 5;
const modes = [
  {
    label: "Isolated",
    note: "openpi baseline",
    total: frameMs(lab.baseline.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "prefill repeat", ms: PREFIX, text: "prefill" },
      { kind: "decode", text: `decode ${N} tokens for one request` },
    ],
  },
  {
    label: "+ KV sharing",
    note: "one prefill for both experts",
    total: frameMs(lab.no_batching.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "decode", text: `decode ${N} tokens for one request` },
    ],
  },
  {
    label: "+ cross-frame batching",
    note: "OxyGen",
    total: frameMs(lab.ours.at(-1)!),
    blocks: [
      { kind: "prefill", ms: PREFIX, text: "prefill" },
      { kind: "denoise", ms: DENOISE, text: "act" },
      { kind: "decode", text: `batch of ${N / K}` },
    ],
  },
];
const SCALE = 550;
const axis = [0, 100, 200, 300, 400, 500];
function layout(mode: (typeof modes)[number]) {
  const fixed = mode.blocks.reduce((sum, block) => sum + (block.ms ?? 0), 0);
  let cursor = 0;
  return mode.blocks.map((block) => {
    const ms = block.ms ?? mode.total - fixed;
    const item = { ...block, left: (cursor / SCALE) * 100, width: (ms / SCALE) * 100 };
    cursor += ms;
    return item;
  });
}
---

<Design />
<p class="method-bridge">One shared prefill removes duplicate work. Carrying language requests across frames then turns many separate decoding passes into one batch.</p>

<div class="grid unit">
  <figure class="c1-8">
    <div class="fig-head"><span class="title"><span class="label"><b>Fig. 3</b></span>What it buys: one control frame, three ways</span></div>
    <div class="lanes">
      {modes.map((mode) => (
        <div class="lane">
          <div class="lane-name">{mode.label}<small>{mode.note}</small></div>
          <div class="lane-track">
            {layout(mode).map((block) => (
              <div class:list={["block", block.kind]} style={`left: ${block.left}%; width: ${block.width}%`}>
                {block.width > 10 ? block.text : ""}
              </div>
            ))}
          </div>
          <div class="lane-total">{mode.total.toFixed(0)} ms<small>{((10 / mode.total) * 1000).toFixed(0)} Hz actions</small></div>
        </div>
      ))}
      <div class="lane-axis" aria-hidden="true">
        <span></span>
        <div>{axis.map((ms) => <span style={`left: ${(ms / SCALE) * 100}%`}>{ms}</span>)}</div>
        <span>ms</span>
      </div>
    </div>
    <div class="key">
      <span><i style="background: var(--baseline)"></i>observation prefill</span>
      <span><i style="background: var(--action)"></i>action denoising</span>
      <span><i style="background: var(--language)"></i>language decoding</span>
    </div>
    <figcaption class="caption">π<sub>0.5</sub> on an RTX 4090; 30-token requests, <i>k</i> = 5, one new request per frame. Frame totals come from the original ablation. Stage widths are illustrative, using the separate camera-ready profile (prefill ≈ {PREFIX.toFixed(1)} ms, denoising ≈ {DENOISE.toFixed(1)} ms); the remaining width includes decoding and other frame work.</figcaption>
  </figure>
  <aside class="c9-12">
    <div class="fig-head"><span class="title">Per frame</span></div>
    <div class="side-note">
      <strong>{(modes[0].total / modes[2].total).toFixed(1)}× shorter</strong>
      <p>{modes[0].total.toFixed(0)} → {modes[2].total.toFixed(0)} ms per frame, so actions update {((10 / modes[2].total) * 1000).toFixed(0)} instead of {((10 / modes[0].total) * 1000).toFixed(0)} times per second.</p>
    </div>
    <div class="side-note">
      <strong>−{(modes[0].total - modes[1].total).toFixed(0)} ms</strong>
      <p>from sharing the prefix: the second prefill disappears.</p>
    </div>
    <div class="side-note">
      <strong>−{(modes[1].total - modes[2].total).toFixed(0)} ms</strong>
      <p>from batching: {N / K} requests share each decoding step, so each frame decodes only {K} steps.</p>
    </div>
  </aside>
</div>
