---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import DemoPlayer from "../components/DemoPlayer.astro";
import Method from "../components/Method.astro";
import TradeoffChart from "../components/TradeoffChart.astro";
import AblationChart from "../components/AblationChart.astro";
import ResultDetails from "../components/ResultDetails.astro";
import Generality from "../components/Generality.astro";
import { citation, links } from "../data/site";
import { memoryAdapter as mem, overhead, quality, qualityProtocol, robot, xiaomi, starvla } from "../data/paper-tables";
import { tradeoff } from "../data/paper-figures";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const sections = [
  { id: "demo", label: "Demo" },
  { id: "method", label: "Method" },
  { id: "results", label: "Results" },
  { id: "robot", label: "Robot" },
  { id: "resources", label: "Resources" },
];

// Resource efficiency on RTX 4090 (Appendix tab:overhead).
const baselineCost = overhead[0];
const parallelCost = overhead[1];
const bestCost = overhead.at(-1)!;
const change = (a: number, b: number) => Math.round((b / a - 1) * 100);

// Headline numbers: π0.5 · LIBERO · RTX 4090 with 30-token requests, OxyGen k = 1.
const headline = tradeoff.libero.rtx4090;
const peak = headline.k1.at(-1)!;
const headlineBaseline = headline.baseline.at(-1)!;
const peakSpeedup = peak[1] / headline.baseline.at(-1)![1];

// LIBERO success (Appendix tab:quality), drawn on a 90–100% axis.
const ciScale = (v: number) => ((v - 90) / 10) * 100;
const overall = quality.at(-1)!;

const robotBase = robot.baseline.action + robot.baseline.language;
const robotOurs = robot.oxygen.action + robot.oxygen.language;
const dispatchMs = robot.oxygen.action;
const motionEndMs = dispatchMs + robot.executionWindowMs;
const pctOfBase = (v: number) => ((v / robotBase) * 100).toFixed(2);

const resources = [
  { href: links.paper, title: "Paper", text: "arXiv preprint, NeurIPS 2026", meta: "arXiv ↗" },
  { href: links.code, title: "Code", text: "JAX and PyTorch backends on openpi", meta: "GitHub ↗" },
  { href: links.blog, title: "Blog", text: "The design, explained step by step", meta: "xxxxyu.github.io ↗" },
  { href: links.model, title: "Adapter", text: "π0.5 textual-memory LoRA", meta: "Hugging Face ↗" },
  { href: links.dataset, title: "Dataset", text: "LIBERO textual-memory annotations", meta: "Hugging Face ↗" },
];
---

<BaseLayout
  title="OxyGen · Unified KV Cache Management for VLA Inference (NeurIPS 2026)"
  description="OxyGen lets Mixture-of-Transformers VLAs generate actions and language at the same time. Cross-task KV sharing and cross-frame continuous batching give up to 3.7× speedup on RTX 4090 and Jetson AGX Thor."
>
  <div class="running-head">
    <div class="page">
      <a class="brand" href="#top">OxyGen</a>
      <span class="current" data-current></span>
      <nav aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </div>
  </div>

  <Hero />

  <main class="page">
    <div class="performance-groups" aria-label="Performance highlights">
      <div class="performance-primary">
        <p class="label"><span class="model-name">π<sub>0.5</sub></span> · actions &amp; language</p>
        <div class="joint-metrics">
          <div class="joint-gain"><strong><span data-count-up>{peakSpeedup.toFixed(1)}</span><small>×</small></strong><p>faster in both outputs</p></div>
          <div class="metric-comparison"><strong><span class="metric-baseline">{Math.round(headlineBaseline[1])}</span><i>→</i><span data-count-up>{Math.round(peak[1])}</span><small>Hz</small></strong><p>action frequency (H=10)</p></div>
          <div class="metric-comparison"><strong><span class="metric-baseline">{Math.round(headlineBaseline[2])}</span><i>→</i><span data-count-up>{Math.round(peak[2])}</span><small>tok/s</small></strong><p>language throughput</p></div>
        </div>
      </div>
      <div class="performance-transfer">
        <p class="label">Speedup across backbones</p>
        <div class="transfer-metrics"><div><strong><span data-count-up>{xiaomi.at(-1)!.k1.toFixed(2)}</span><small>×</small></strong><p>Xiaomi-Robotics-0</p></div><div><strong><span data-count-up>{starvla[2].at(-1)!.k1.toFixed(2)}</span><small>×</small></strong><p>StarVLA</p></div></div>
      </div>
    </div>


    <section class="section" id="demo" data-title="Demo">
      <SectionHead number="1" label="Demo">
        <Fragment slot="title">Same task. <em>Less waiting.</em></Fragment>
      </SectionHead>
      <DemoPlayer />
    </section>

    <section class="section" id="method" data-title="Method">
      <SectionHead number="2" label="Method">
        <Fragment slot="title">One cache. <em>Across tasks and time.</em></Fragment>
        Share the observation.<br />Batch language across frames.
      </SectionHead>
      <Method />
    </section>

    <section class="section" id="results" data-title="Results">
      <SectionHead number="3" label="Results">
        <Fragment slot="title">Faster actions <em>and</em> more language.</Fragment>
        Measurements on desktop and on-board GPUs, followed by transfer across backbones and model sizes.
      </SectionHead>

      <div class="result-overview">
        <div class="result-charts">
          <TradeoffChart />
          <AblationChart />
        </div>
        <div class="result-transfer"><Generality /></div>
      </div>

      <div class="result-block">
      <div class="grid quality-efficiency">
        <figure class="quality-result ci compact-result">
          <div class="fig-head"><span class="title">OxyGen leaves the action policy unchanged.</span></div>
          <p class="result-line"><strong>{overall.mean.toFixed(2)}%</strong><span>LIBERO success, matching openpi ({overall.openpi}%).</span><button type="button" class="method-settings-trigger" popovertarget="quality-details">Details</button></p>
          <div id="quality-details" class="method-popover" popover aria-label="Measurement details"><strong>Measurement details</strong><p>{qualityProtocol.seeds} seeds, {qualityProtocol.rollouts.toLocaleString("en-US")} rollouts, official π<sub>0.5</sub>-LIBERO checkpoint. OxyGen changes the inference schedule only; the policy and action outputs are unchanged.</p></div>
        </figure>
        <figure class="efficiency-result compact-result">
          <div class="fig-head"><span class="title">Batching cuts energy per request by 78%.</span></div>
          <p class="result-line"><strong>−78%</strong><span>energy per request · −47% power · +15% memory.</span><button type="button" class="method-settings-trigger" popovertarget="efficiency-details">Details</button></p>
          <div id="efficiency-details" class="method-popover" popover aria-label="Measurement details"><strong>Measurement details</strong><p>RTX 4090, OxyGen batch size 4. The table compares isolated execution with batched decoding, which reads the VLM weights once for several requests. Parallel processes (MPS) use {parallelCost.memGiB} GiB and {parallelCost.energyJ} J per request.</p></div>
        </figure>
      </div>
      </div>
    </section>

    <section class="section" id="robot" data-title="On the robot">
      <SectionHead number="4" label="On-board measurement">
        <Fragment slot="title">Lower latency, <em>on board.</em></Fragment>
        {(robotBase / robotOurs).toFixed(1)}× faster inference on the on-board Jetson AGX Thor, with room for language during motion.
      </SectionHead>
      <div class="grid onboard-grid">
        <figure class="c1-4 plate setup-plate">
          <img src={`${base}images/humanoid-jetson-thor.webp`} alt="Humanoid robot with an on-board NVIDIA Jetson AGX Thor" loading="lazy" width="1200" height="1600" />
        </figure>
        <div class="c5-12 onboard-measurement">
          <div class="fig-head"><span class="title">Faster inference leaves room for language during motion.</span><span class="onboard-gain">{(robotBase / robotOurs).toFixed(1)}×</span></div>
          <figure class="robot-timeline">
            <div class="robot-lane">
              <div class="robot-lane-title"><strong>Isolated baseline</strong><span>{robotBase.toFixed(0)} ms</span></div>
              <div class="robot-track"><i class="robot-action" style={`width:${pctOfBase(robot.baseline.action)}%`}>{robot.baseline.action}</i><i class="robot-language" style={`width:${pctOfBase(robot.baseline.language)}%`}>{robot.baseline.language}</i></div>
            </div>
            <div class="robot-lane">
              <div class="robot-lane-title"><strong>OxyGen</strong><span class="c-action">{robotOurs.toFixed(0)} ms</span></div>
              <div class="robot-track"><i class="robot-action" style={`width:${pctOfBase(robot.oxygen.action)}%`}>{robot.oxygen.action.toFixed(0)}</i><i class="robot-language" style={`width:${pctOfBase(robot.oxygen.language)}%`}>{robot.oxygen.language.toFixed(0)}</i></div>
              <div class="robot-motion-track" style={`--dispatch:${pctOfBase(dispatchMs)}%`}>
                <span class="robot-dispatch">dispatch</span>
                <div class="robot-motion" style={`margin-left:${pctOfBase(dispatchMs)}%;width:${pctOfBase(robot.executionWindowMs)}%`}>Motion window · {robot.executionWindowMs} ms</div>
              </div>
            </div>
            <div class="robot-chart-notes"><div class="key"><span><i style="background:var(--action)"></i>action generation</span><span><i style="background:var(--language)"></i>language generation</span></div>
            <ResultDetails id="robot-details"><p>π<sub>0.5</sub> on Jetson AGX Thor: <i>H</i> = 10, <i>S</i> = 10, <i>N</i> = 30, <i>k</i> = 5. Input: three 224 × 224 RGB views. Action timings include prefill and denoising; the speedup compares total inference time.</p><p>The motion window illustrates where physical execution could overlap language after action dispatch. It uses measured inference stages and a {robot.executionWindowMs} ms execution window; communication overhead is omitted. All bars share the same time scale.</p></ResultDetails></div>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="resources" data-title="Resources">
      <SectionHead number="5" label="Resources">
        <Fragment slot="title">Read it, run it, <em>build on it.</em></Fragment>
      </SectionHead>
      <div class="grid resources-grid">
        <div class="c1-6">
          <div class="fig-head"><span class="title">Links</span></div>
          <ul class="resources">
            {resources.map((r) => (
              <li><a href={r.href} target="_blank" rel="noreferrer"><strong>{r.title}</strong><span>{r.text}</span><em>{r.meta}</em></a></li>
            ))}
          </ul>
        </div>
        <div class="c7-12 citation">

          <div class="fig-head"><span class="title">Citation</span><button id="copy-citation" class="copy" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1.5"></rect><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"></path></svg><span>Copy BibTeX</span></button></div>
          <pre><code id="citation-text">{citation}</code></pre>
        </div>
      </div>
    </section>

    <footer class="colophon grid">
      <p class="c1-6">OxyGen · Unified KV cache management for VLA inference</p>
      <p class="c7-12">Built on <a href="https://github.com/Physical-Intelligence/openpi" target="_blank" rel="noreferrer">openpi</a>. Code released under Apache 2.0.</p>
    </footer>
  </main>

  <div class="tooltip" id="tooltip" role="status"></div>

  <script>
    import { initPage } from "../scripts/page";
    initPage();
  </script>
</BaseLayout>
