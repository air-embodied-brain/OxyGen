---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import DemoPlayer from "../components/DemoPlayer.astro";
import Method from "../components/Method.astro";
import TradeoffChart from "../components/TradeoffChart.astro";
import AblationChart from "../components/AblationChart.astro";
import Generality from "../components/Generality.astro";
import { citation, links } from "../data/site";
import { overhead, quality, robot } from "../data/paper-tables";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const sections = [
  { id: "demo", label: "Demo" },
  { id: "method", label: "Method" },
  { id: "results", label: "Results" },
  { id: "robot", label: "Robot" },
  { id: "resources", label: "Resources" },
];

// Resource efficiency on RTX 4090 (Appendix tab:overhead).
const baselineCost = overhead[0];
const bestCost = overhead.at(-1)!;
const energyCut = 1 - bestCost.energyJ / baselineCost.energyJ;
const powerCut = 1 - bestCost.powerW / baselineCost.powerW;
const memoryAdd = bestCost.memGiB / baselineCost.memGiB - 1;

// LIBERO success (Appendix tab:quality), drawn on a 90–100% axis.
const ciScale = (v: number) => ((v - 90) / 10) * 100;
const overall = quality.at(-1)!;

const robotBase = robot.baseline.action + robot.baseline.language;
const robotOurs = robot.oxygen.action + robot.oxygen.language;
const pctOfBase = (v: number) => ((v / robotBase) * 100).toFixed(2);

const resources = [
  { href: links.paper, title: "Paper", text: "arXiv preprint, NeurIPS 2026", meta: "arXiv ↗" },
  { href: links.code, title: "Code", text: "JAX and PyTorch backends built on openpi", meta: "GitHub ↗" },
  { href: links.blog, title: "Blog post", text: "The design, explained step by step", meta: "xxxxyu.github.io ↗" },
  { href: links.model, title: "Adapter", text: "π0.5 textual-memory LoRA", meta: "Hugging Face ↗" },
  { href: links.dataset, title: "Dataset", text: "LIBERO textual-memory annotations", meta: "Hugging Face ↗" },
];
---

<BaseLayout
  title="OxyGen · Unified KV Cache Management for VLA Inference (NeurIPS 2026)"
  description="OxyGen lets Mixture-of-Transformers VLAs generate actions and language at the same time. Cross-task KV sharing and cross-frame continuous batching give up to 3.7× speedup on RTX 4090 and Jetson AGX Thor."
>
  <div class="running-head" data-head>
    <div class="page">
      <a class="brand" href="#top">OxyGen</a>
      <span class="current" data-current></span>
      <nav aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </div>
  </div>

  <Hero />

  <main class="page">
    <div class="stats grid" aria-label="Headline results">
      <div class="stat"><strong>3.7<small>×</small></strong><p>faster than isolated execution, π<sub>0.5</sub> on RTX 4090</p></div>
      <div class="stat"><strong>70<small>Hz</small></strong><p>action frequency while generating over 200 tokens/s of language</p></div>
      <div class="stat"><strong>−{Math.round(energyCut * 100)}<small>%</small></strong><p>energy per request, with batched language decoding</p></div>
      <div class="stat"><strong>96.8<small>%</small></strong><p>LIBERO success, on par with the official openpi checkpoint</p></div>
    </div>

    <section class="section" id="demo" data-title="Demo">
      <SectionHead number="1" label="Demo">
        <Fragment slot="title">Same robot, same model, <em>less waiting.</em></Fragment>
      </SectionHead>
      <DemoPlayer />
    </section>

    <section class="section" id="method" data-title="Method">
      <SectionHead number="2" label="Method">
        <Fragment slot="title">One cache, <em>shared across tasks and time.</em></Fragment>
        Mixture-of-Transformers VLAs such as π<sub>0.5</sub> already share one backbone between action and language experts, yet existing inference stacks still run each task in isolation. OxyGen manages the KV cache as one resource.
      </SectionHead>
      <Method />
    </section>

    <section class="section" id="results" data-title="Results">
      <SectionHead number="3" label="Results">
        <Fragment slot="title">Faster actions <em>and</em> more language.</Fragment>
        Under isolated execution, longer answers mean slower control. OxyGen moves the whole frontier: at matched answer lengths it improves both action frequency and language throughput, by up to 3.7×.
      </SectionHead>
      <TradeoffChart />

      <figure class="fig grid">
        <figcaption class="fig-caption">
          <span class="label"><b>Fig. 4</b></span>
          <p>LIBERO configuration, <i>k</i> = 5. KV sharing removes the repeated prefill and matters most for short answers; batching keeps action frequency nearly flat as answers grow. The dashed line is the frequency with only one frame of decoding.</p>
        </figcaption>
        <div class="fig-body pair">
          <div><AblationChart /></div>
          <div>
            <div class="fig-toolbar"><span class="title">Cost per request, RTX 4090</span></div>
            <table class="data">
              <thead><tr><th scope="col" style="text-align: left"></th><th scope="col">Baseline</th><th scope="col">OxyGen</th><th scope="col">Change</th></tr></thead>
              <tbody>
                <tr><td class="name">Energy</td><td>{baselineCost.energyJ} J</td><td>{bestCost.energyJ} J</td><td class="c-action">−{Math.round(energyCut * 100)}%</td></tr>
                <tr><td class="name">Avg. power</td><td>{baselineCost.powerW} W</td><td>{bestCost.powerW} W</td><td class="c-action">−{Math.round(powerCut * 100)}%</td></tr>
                <tr><td class="name">Peak memory</td><td>{baselineCost.memGiB} GiB</td><td>{bestCost.memGiB} GiB</td><td>+{Math.round(memoryAdd * 100)}%</td></tr>
              </tbody>
            </table>
            <p class="note">OxyGen at batch size 4. Running both tasks as parallel processes instead needs {overhead[1].memGiB} GiB and {overhead[1].energyJ} J per request.</p>
          </div>
        </div>
      </figure>

      <Generality />

      <figure class="fig grid">
        <figcaption class="fig-caption">
          <span class="label"><b>Fig. 5</b></span>
          <span class="big">{overall.mean.toFixed(2)}%</span>
          <p>Mean LIBERO success over 10 seeds and 20,000 rollouts with the official π<sub>0.5</sub>-LIBERO checkpoint; openpi reports {overall.openpi}%. OxyGen changes the schedule, not the policy.</p>
        </figcaption>
        <div class="fig-body ci">
          <div class="fig-toolbar"><span class="title">Success rate by suite, 95% confidence interval</span></div>
          {quality.map((row) => (
            <div class:list={["ci-row", row.suite === "Overall" && "overall"]}>
              <span>{row.suite}</span>
              <div class="ci-track" title={`OxyGen ${row.mean}% [${row.ci[0]}, ${row.ci[1]}] · openpi ${row.openpi}%`}>
                <span class="range" style={`left: ${ciScale(row.ci[0])}%; width: ${ciScale(row.ci[1]) - ciScale(row.ci[0])}%`}></span>
                <span class="ref" style={`left: ${ciScale(row.openpi)}%`}></span>
                <span class="mean" style={`left: ${ciScale(row.mean)}%`}></span>
              </div>
              <span class="val">{row.mean.toFixed(2)}<small>/ {row.openpi.toFixed(2)}</small></span>
            </div>
          ))}
          <div class="ci-axis"><span></span><div><span>90%</span><span>95%</span><span>100%</span></div><span></span></div>
          <div class="key">
            <span><i style="width: 9px; height: 9px; border-radius: 50%; background: var(--action)"></i>OxyGen mean and 95% CI</span>
            <span><i style="width: 1.5px; height: 13px; background: var(--ink)"></i>openpi reported</span>
          </div>
        </div>
      </figure>
    </section>

    <section class="section" id="robot" data-title="On the robot">
      <SectionHead number="4" label="On the robot">
        <Fragment slot="title">On board <em>a humanoid.</em></Fragment>
      </SectionHead>
      <div class="grid">
        <figure class="plate">
          <img src={`${base}images/humanoid-jetson-thor.webp`} alt="Humanoid robot with an on-board NVIDIA Jetson AGX Thor" loading="lazy" width="1200" height="1600" />
          <figcaption><b>Plate 1.</b> The humanoid and its on-board Jetson AGX Thor.</figcaption>
        </figure>
        <div class="robot-copy">
          <dl class="specs">
            <dt>Compute</dt><dd>NVIDIA Jetson AGX Thor, on board</dd>
            <dt>Model</dt><dd>π<sub>0.5</sub>, actions and language from shared observations</dd>
            <dt>Input</dt><dd>3 RGB views at 224 × 224</dd>
            <dt>Workload</dt><dd>H = 10, S = 10, 30-token requests, <i>k</i> = 5</dd>
          </dl>
          <div class="fig-toolbar"><span class="title">Inference per control cycle</span></div>
          <div class="latency">
            <div class="latency-row">
              <h4>Isolated baseline <span>{robotBase.toFixed(0)}<small>ms</small></span></h4>
              <div class="latency-track">
                <div class="seg act" style={`width: ${pctOfBase(robot.baseline.action)}%`}>{robot.baseline.action}</div>
                <div class="seg lang" style={`width: ${pctOfBase(robot.baseline.language)}%`}>language {robot.baseline.language}</div>
              </div>
            </div>
            <div class="latency-row">
              <h4>OxyGen <span class="c-action">{robotOurs.toFixed(0)}<small>ms</small></span></h4>
              <div class="latency-track">
                <div class="seg act" style={`width: ${pctOfBase(robot.oxygen.action)}%`}>{robot.oxygen.action}</div>
                <div class="seg lang" style={`width: ${pctOfBase(robot.oxygen.language)}%`}>{robot.oxygen.language}</div>
                <span class="window" style={`left: ${pctOfBase(robot.executionWindowMs)}%`}><span>{robot.executionWindowMs} ms action window</span></span>
              </div>
            </div>
          </div>
          <ul class="robot-facts">
            <li>Combined inference drops from {robotBase.toFixed(0)} to {robotOurs.toFixed(0)} ms, <b>{(robotBase / robotOurs).toFixed(1)}× shorter</b>.</li>
            <li>The action path takes {robot.oxygen.action.toFixed(0)} ms, <b>inside the robot's {robot.executionWindowMs} ms execution window</b>; the remaining language work can overlap with motion.</li>
            <li>The language path is <b>{(robot.baseline.language / robot.oxygen.language).toFixed(1)}× faster</b>, from KV sharing and batching together.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="memory" data-title="Textual memory">
      <SectionHead number="5" label="Application">
        <Fragment slot="title">A robot that <em>keeps notes.</em></Fragment>
        The demo's language task is textual memory. A rank-16 LoRA on the frozen π<sub>0.5</sub> checkpoint writes one line about task progress from the current observation. It runs only on the private language suffix, so the shared prefix and the action path stay untouched.
      </SectionHead>
      <div class="grid">
        <div class="rail note" style="margin: 0">
          <span class="label" style="display: block; margin-bottom: 6px"><b>Log</b></span>
          Memories written by OxyGen in the alphabet-soup rollout of Fig. 1. Task: put both the alphabet soup and the tomato sauce in the basket.
        </div>
        <ol class="memory-log">
          <li><span>step 50</span><q>No relevant task progress is visible yet.</q></li>
          <li class="new"><span>step 185</span><q>The alphabet soup is in the basket.</q></li>
        </ol>
        <dl class="memory-stats">
          <div><dt>87.25%</dt><dd>exact match on held-out frames</dd></div>
          <div><dt>8.16 ms</dt><dd>median adapter cost per memory, against a 47.66 ms prefix forward</dd></div>
          <div><dt>0</dt><dd>change to actions with the adapter zeroed</dd></div>
          <div><dt>338,575</dt><dd>annotated frames from 2,000 LIBERO demonstrations</dd></div>
        </dl>
      </div>
      <div class="grid"><p class="note main" style="margin-top: 20px">Developed after the main experiments; it does not change the paper's latency or action-quality results. Numbers from the <a href={links.model} target="_blank" rel="noreferrer">model card</a> and the OxyGen repository, measured on RTX 4090.</p></div>
    </section>

    <section class="section" id="resources" data-title="Resources">
      <SectionHead number="6" label="Resources">
        <Fragment slot="title">Read it, run it, <em>build on it.</em></Fragment>
      </SectionHead>
      <div class="grid">
        <ul class="resources">
          {resources.map((r) => (
            <li><a href={r.href} target="_blank" rel="noreferrer"><strong>{r.title}</strong><span>{r.text}</span><em>{r.meta}</em></a></li>
          ))}
        </ul>
        <div class="citation">
          <div class="citation-head"><span class="label"><b>Citation</b></span><button id="copy-citation" type="button">Copy BibTeX</button></div>
          <pre><code id="citation-text">{citation}</code></pre>
        </div>
      </div>
    </section>

    <footer class="colophon grid">
      <p>OxyGen · Unified KV cache management for VLA inference</p>
      <p>Built on <a href="https://github.com/Physical-Intelligence/openpi" target="_blank" rel="noreferrer">openpi</a>. Code released under Apache 2.0.</p>
    </footer>
  </main>

  <div class="tooltip" id="tooltip" role="status"></div>

  <script>
    import { initPage } from "../scripts/page";
    initPage();
  </script>
</BaseLayout>
