---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHead from "../components/SectionHead.astro";
import DemoPlayer from "../components/DemoPlayer.astro";
import Method from "../components/Method.astro";
import TradeoffChart from "../components/TradeoffChart.astro";
import AblationChart from "../components/AblationChart.astro";
import Generality from "../components/Generality.astro";
import { citation, links } from "../data/site";
import { memoryAdapter as mem, overhead, quality, qualityProtocol, robot, xiaomi, starvla } from "../data/paper-tables";
import { tradeoff } from "../data/paper-figures";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const sections = [
  { id: "demo", label: "Demo" },
  { id: "method", label: "Method" },
  { id: "results", label: "Results" },
  { id: "robot", label: "Robot" },
  { id: "resources", label: "Resources" },
];

// Resource efficiency on RTX 4090 (Appendix tab:overhead).
const baselineCost = overhead[0];
const parallelCost = overhead[1];
const bestCost = overhead.at(-1)!;
const change = (a: number, b: number) => Math.round((b / a - 1) * 100);

// Headline numbers: π0.5 · LIBERO · RTX 4090 with 30-token requests, OxyGen k = 1.
const headline = tradeoff.libero.rtx4090;
const peak = headline.k1.at(-1)!;
const peakSpeedup = peak[1] / headline.baseline.at(-1)![1];

// LIBERO success (Appendix tab:quality), drawn on a 90–100% axis.
const ciScale = (v: number) => ((v - 90) / 10) * 100;
const overall = quality.at(-1)!;

const robotBase = robot.baseline.action + robot.baseline.language;
const robotOurs = robot.oxygen.action + robot.oxygen.language;
const pctOfBase = (v: number) => ((v / robotBase) * 100).toFixed(2);

const resources = [
  { href: links.paper, title: "Paper", text: "arXiv preprint, NeurIPS 2026", meta: "arXiv ↗" },
  { href: links.code, title: "Code", text: "JAX and PyTorch backends on openpi", meta: "GitHub ↗" },
  { href: links.blog, title: "Blog", text: "The design, explained step by step", meta: "xxxxyu.github.io ↗" },
  { href: links.model, title: "Adapter", text: "π0.5 textual-memory LoRA", meta: "Hugging Face ↗" },
  { href: links.dataset, title: "Dataset", text: "LIBERO textual-memory annotations", meta: "Hugging Face ↗" },
];
---

<BaseLayout
  title="OxyGen · Unified KV Cache Management for VLA Inference (NeurIPS 2026)"
  description="OxyGen lets Mixture-of-Transformers VLAs generate actions and language at the same time. Cross-task KV sharing and cross-frame continuous batching give up to 3.7× speedup on RTX 4090 and Jetson AGX Thor."
>
  <div class="running-head">
    <div class="page">
      <a class="brand" href="#top">OxyGen</a>
      <span class="current" data-current></span>
      <nav aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
    </div>
  </div>

  <Hero />

  <main class="page">
    <div class="stats grid performance-strip" aria-label="Performance highlights">
      <div class="stat lead-stat"><strong><span data-count-up>{peakSpeedup.toFixed(1)}</span><small>×</small></strong><p>faster action updates <em>and</em> language throughput<br />π<sub>0.5</sub> · RTX 4090 · N = 30, k = 1</p></div>
      <div class="stat"><strong><span data-count-up>{Math.floor(peak[1])}</span><small>Hz</small></strong><p>action frequency, alongside {Math.round(peak[2])} language tokens/s</p></div>
      <div class="stat transfer-stat"><span class="label">Across backbones</span><p><b>{xiaomi.at(-1)!.k1.toFixed(2)}×</b> Xiaomi-Robotics-0<br /><b>{starvla[2].at(-1)!.k1.toFixed(2)}×</b> StarVLA</p><small>RTX 4090 · N = 30, k = 1<br />Each against its own isolated baseline</small></div>
    </div>

    <section class="section" id="demo" data-title="Demo">
      <SectionHead number="1" label="Demo">
        <Fragment slot="title">Same robot, same model, <em>less waiting.</em></Fragment>
      </SectionHead>
      <DemoPlayer />
    </section>

    <section class="section" id="method" data-title="Method">
      <SectionHead number="2" label="Method">
        <Fragment slot="title">One cache, <em>shared across tasks and time.</em></Fragment>
        Reuse the observation once across experts. Then batch unfinished language requests across control frames. Two changes to the inference schedule, one shared KV cache.
      </SectionHead>
      <Method />
    </section>

    <section class="section" id="results" data-title="Results">
      <SectionHead number="3" label="Results">
        <Fragment slot="title">Faster actions <em>and</em> more language.</Fragment>
        Under isolated execution, longer answers mean slower control. In the π<sub>0.5</sub> experiments below, OxyGen extends the action-frequency / language-throughput frontier, with gains up to {peakSpeedup.toFixed(1)}×.
      </SectionHead>

      <div class="result-block"><div class="result-intro"><span class="label">01 / Joint performance</span><h3>Longer answers. <em>Sustained action frequency.</em></h3><p>At matched output lengths, batching improves both axes. Compare the same workload on desktop and on-board GPUs.</p></div><TradeoffChart /></div>

      <div class="result-block"><div class="result-intro"><span class="label">02 / Where the gains come from</span><h3>Share the prefix. <em>Amortize the decoding.</em></h3><p>KV sharing removes repeated observation processing; batching keeps action frequency nearly flat as requests grow longer.</p></div><AblationChart /></div>

      <div class="result-block"><div class="result-intro"><span class="label">03 / Generality</span><h3>Across backbones, <em>experts and model sizes.</em></h3><p>The same scheduling idea transfers beyond π<sub>0.5</sub>. Each result compares OxyGen with isolated execution within its own configuration.</p></div><Generality /></div>

      <div class="result-block"><div class="result-intro compact"><span class="label">04 / Quality &amp; resources</span><h3>Comparable task success. <em>Less energy per request.</em></h3></div>
      <div class="grid">
        <figure class="c1-7 ci">
          <div class="fig-head"><span class="title"><span class="label"><b>Fig. 6</b></span>Action quality on LIBERO</span></div>
          <div class="panel-head"><span>Mean success, 95% CI</span><span class="gain">{overall.mean.toFixed(2)}%<small>openpi: {overall.openpi}%</small></span></div>
          {quality.map((row) => (
            <div class:list={["ci-row", row.suite === "Overall" && "overall"]}>
              <span>{row.suite}</span>
              <div class="ci-track" title={`OxyGen ${row.mean}% [${row.ci[0]}, ${row.ci[1]}] · openpi ${row.openpi}%`}>
                <span class="range" style={`left: ${ciScale(row.ci[0])}%; width: ${ciScale(row.ci[1]) - ciScale(row.ci[0])}%`}></span>
                <span class="ref" style={`left: ${ciScale(row.openpi)}%`}></span>
                <span class="mean" style={`left: ${ciScale(row.mean)}%`}></span>
              </div>
              <span class="val">{row.mean.toFixed(2)}<small>/ {row.openpi.toFixed(2)}</small></span>
            </div>
          ))}
          <div class="ci-axis"><span></span><div><span>90%</span><span>95%</span><span>100%</span></div><span></span></div>
          <div class="key">
            <span><i style="width: 9px; height: 9px; border-radius: 50%; background: var(--action)"></i>OxyGen mean and 95% CI</span>
            <span><i style="width: 1.5px; height: 13px; background: var(--ink)"></i>openpi reported</span>
          </div>
          <figcaption class="caption">{qualityProtocol.seeds} seeds, {qualityProtocol.rollouts.toLocaleString("en-US")} rollouts, official π<sub>0.5</sub>-LIBERO checkpoint. OxyGen changes the schedule, not the policy.</figcaption>
        </figure>
        <figure class="c8-12">
          <div class="fig-head"><span class="title">Cost per request, RTX 4090</span></div>
          <div class="panel-head"><span>Energy per request</span><span class="gain">−{-change(baselineCost.energyJ, bestCost.energyJ)}%<small>vs. baseline</small></span></div>
          <table class="data">
            <thead><tr><th scope="col"><span class="sr-only">Metric</span></th><th scope="col">Baseline</th><th scope="col">OxyGen</th><th scope="col">Δ</th></tr></thead>
            <tbody>
              <tr><td class="name">Energy</td><td>{baselineCost.energyJ} J</td><td>{bestCost.energyJ} J</td><td class="c-action">−{-change(baselineCost.energyJ, bestCost.energyJ)}%</td></tr>
              <tr><td class="name">Power</td><td>{baselineCost.powerW} W</td><td>{bestCost.powerW} W</td><td class="c-action">−{-change(baselineCost.powerW, bestCost.powerW)}%</td></tr>
              <tr><td class="name">Memory</td><td>{baselineCost.memGiB} GiB</td><td>{bestCost.memGiB} GiB</td><td>+{change(baselineCost.memGiB, bestCost.memGiB)}%</td></tr>
            </tbody>
          </table>
          <figcaption class="caption">OxyGen at batch size 4. Batched decoding reads the VLM weights once for several requests. Running the two tasks as parallel processes instead needs {parallelCost.memGiB} GiB and {parallelCost.energyJ} J per request.</figcaption>
        </figure>
      </div>
      </div>
    </section>

    <section class="section" id="robot" data-title="On the robot">
      <SectionHead number="4" label="On-board measurement">
        <Fragment slot="title">Lower latency, <em>on board.</em></Fragment>
        On the humanoid’s Jetson AGX Thor, the measured action path takes {robot.oxygen.action.toFixed(0)} ms. Language generation can overlap with physical execution.
      </SectionHead>
      <div class="grid onboard-grid">
        <figure class="c1-4 plate setup-plate">
          <img src={`${base}images/humanoid-jetson-thor.webp`} alt="Humanoid robot with an on-board NVIDIA Jetson AGX Thor" loading="lazy" width="1200" height="1600" />
          <figcaption class="caption"><b>SETUP</b> Humanoid with on-board Jetson AGX Thor. Three RGB views at 224 × 224.</figcaption>
        </figure>
        <div class="c5-12 onboard-measurement">
          <dl class="specs">
            <div><dt>Compute</dt><dd>Jetson AGX Thor, on board</dd></div>
            <div><dt>Input</dt><dd>3 RGB views, 224 × 224</dd></div>
            <div><dt>Actions</dt><dd>H = 10, S = 10 denoising steps</dd></div>
            <div><dt>Language</dt><dd>30-token requests, <i>k</i> = 5</dd></div>
          </dl>
          <div class="fig-head"><span class="title"><span class="label"><b>Fig. 7</b></span>Inference per control cycle</span></div>
          <div class="latency">
            <div class="latency-row">
              <h4>Isolated baseline <span>{robotBase.toFixed(0)}<small>ms</small></span></h4>
              <div class="latency-track">
                <div class="seg act" style={`width: ${pctOfBase(robot.baseline.action)}%`}>{robot.baseline.action}</div>
                <div class="seg lang" style={`width: ${pctOfBase(robot.baseline.language)}%`}>language {robot.baseline.language}</div>
              </div>
            </div>
            <div class="latency-row">
              <h4>OxyGen <span class="c-action">{robotOurs.toFixed(0)}<small>ms</small></span></h4>
              <div class="latency-track">
                <div class="seg act" style={`width: ${pctOfBase(robot.oxygen.action)}%`}>{robot.oxygen.action}</div>
                <div class="seg lang" style={`width: ${pctOfBase(robot.oxygen.language)}%`}>{robot.oxygen.language}</div>
                <span class="window" style={`left: ${pctOfBase(robot.executionWindowMs)}%`}><span>{robot.executionWindowMs} ms action execution</span></span>
              </div>
            </div>
          </div>
          <div class="key" style="margin-top: 34px">
            <span><i style="background: var(--action)"></i>action path: prefill and denoising</span>
            <span><i style="background: var(--language)"></i>language path</span>
          </div>
          <div class="facts">
            <div><strong>{(robotBase / robotOurs).toFixed(1)}×</strong><p>shorter combined inference, {robotBase.toFixed(0)} → {robotOurs.toFixed(0)} ms</p></div>
            <div><strong>{robot.oxygen.action.toFixed(0)} ms</strong><p>action path, inside the {robot.executionWindowMs} ms execution window; language can overlap with motion</p></div>
            <div><strong>{(robot.baseline.language / robot.oxygen.language).toFixed(1)}×</strong><p>faster language path, from KV sharing and batching together</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="memory" data-title="Textual memory">
      <SectionHead number="5" label="Application">
        <Fragment slot="title">A robot that <em>keeps notes.</em></Fragment>
        The opening demo gives language a job: record task progress. A rank-{mem.rank} LoRA writes memories from the private language suffix, with the shared prefix and action path frozen.
      </SectionHead>
      <div class="grid">
        <figure class="c1-7">
          <div class="fig-head"><span class="title"><span class="label"><b>Fig. 8</b></span>Memories written during Fig. 1</span></div>
          <ol class="memory-log">
            <li class="task"><span>task</span><p>Put both the alphabet soup and the tomato sauce in the basket.</p></li>
            <li><span>step 50</span><q>No relevant task progress is visible yet.</q></li>
            <li class="new"><span>step 185</span><q>The alphabet soup is in the basket.</q></li>
          </ol>
          <figcaption class="caption">From the OxyGen run of the alphabet-soup demo. The adapter was developed after the main experiments; the paper's latency and quality results do not depend on it.</figcaption>
        </figure>
        <div class="c8-12">
          <div class="fig-head"><span class="title">Adapter, RTX 4090</span></div>
          <dl class="memory-stats">
            <div><dt>{mem.exactMatchPct}%</dt><dd>exact match on held-out frames</dd></div>
            <div><dt>{mem.actionDiff}</dt><dd>change to actions with the adapter zeroed</dd></div>
          </dl>
          <p class="caption">{mem.adapterMs} ms median per memory, vs. {mem.prefixForwardMs} ms for a prefix forward. Trained with {mem.annotatedFrames.toLocaleString("en-US")} annotated frames from {mem.demonstrations.toLocaleString("en-US")} demonstrations. See the <a href={links.model} target="_blank" rel="noreferrer">model card</a> and the OxyGen repository.</p>
        </div>
      </div>
    </section>

    <section class="section" id="resources" data-title="Resources">
      <SectionHead number="6" label="Resources">
        <Fragment slot="title">Read it, run it, <em>build on it.</em></Fragment>
      </SectionHead>
      <div class="grid">
        <div class="c1-6">
          <div class="fig-head"><span class="title">Links</span></div>
          <ul class="resources">
            {resources.map((r) => (
              <li class:list={[r.title === "Paper" || r.title === "Code" ? "primary-resource" : ""]}><a href={r.href} target="_blank" rel="noreferrer"><strong>{r.title}</strong><span>{r.text}</span><em>{r.meta}</em></a></li>
            ))}
          </ul>
        </div>
        <div class="c7-12 citation">
          <div class="fig-head"><span class="title">Citation</span><button id="copy-citation" class="copy" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1.5"></rect><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"></path></svg><span>Copy BibTeX</span></button></div>
          <pre><code id="citation-text">{citation}</code></pre>
        </div>
      </div>
    </section>

    <footer class="colophon grid">
      <p class="c1-6">OxyGen · Unified KV cache management for VLA inference</p>
      <p class="c7-12">Built on <a href="https://github.com/Physical-Intelligence/openpi" target="_blank" rel="noreferrer">openpi</a>. Code released under Apache 2.0.</p>
    </footer>
  </main>

  <div class="tooltip" id="tooltip" role="status"></div>

  <script>
    import { initPage } from "../scripts/page";
    initPage();
  </script>
</BaseLayout>
